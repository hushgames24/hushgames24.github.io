---
import { developerProfile } from '../data/portfolioData';
---

<header class="sticky top-0 z-40 border-b border-[#27272a] bg-[#09090b]/90 backdrop-blur-md">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
    
    <!-- Monogram Logo & Title -->
    <a href="#top" class="flex items-center gap-3 group">
      <span class="w-8 h-8 rounded bg-zinc-900 border border-[#27272a] flex items-center justify-center font-mono text-xs font-semibold text-zinc-100 group-hover:border-zinc-500 group-hover:text-emerald-400 transition-colors">
        {developerProfile.initials}
      </span>
      <div class="flex flex-col">
        <span class="text-sm font-semibold text-zinc-100 tracking-tight group-hover:text-white transition-colors">
          {developerProfile.name}
        </span>
        <span class="text-[11px] font-mono text-zinc-500">
          {developerProfile.title}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-xs font-mono text-zinc-400">
      <a href="#featured" class="hover:text-zinc-100 transition-colors">Featured</a>
      <a href="#shipped" class="hover:text-zinc-100 transition-colors">Releases</a>
      <a href="#prototypes" class="hover:text-zinc-100 transition-colors">Prototypes</a>
      <a href="#skills" class="hover:text-zinc-100 transition-colors">Skills</a>
      <a href="#contact" class="hover:text-zinc-100 transition-colors">Contact</a>
    </nav>

    <!-- Desktop External & Contact CTAs -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href={developerProfile.itch}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono font-medium rounded border border-[#27272a] bg-zinc-900/80 text-zinc-300 hover:text-white hover:border-zinc-500 hover:bg-zinc-800 transition-all"
        aria-label="itch.io profile"
      >
        <svg class="w-3.5 h-3.5 fill-current text-[#fa5c5c]" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2.5 4.5v1.2l2.3 2.3-2.3 2.3v9.2l4.6 2.3 4.6-2.3-2.3-2.3 2.3-2.3h4.6l2.3 2.3-2.3 2.3 4.6 2.3 4.6-2.3v-9.2l-2.3-2.3 2.3-2.3V4.5l-4.6 2.3-4.6-2.3-2.3 2.3-2.3-2.3-4.6 2.3-4.6-2.3zm6.9 7.4a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zm5.2 0a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6z"/>
        </svg>
        <span>itch.io</span>
      </a>

      <a
        href="#contact"
        class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-mono font-medium rounded bg-zinc-100 text-zinc-950 hover:bg-white transition-colors"
      >
        <span>Contact</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobileMenuBtn"
      type="button"
      aria-label="Toggle Navigation"
      class="md:hidden p-2 rounded text-zinc-400 hover:text-white hover:bg-zinc-900 border border-transparent hover:border-[#27272a] transition-colors"
    >
      <svg id="navHamburgerIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16m-7 6h7"/>
      </svg>
      <svg id="navCloseIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobileMenu" class="hidden md:hidden border-b border-[#27272a] bg-[#09090b] px-5 py-4 space-y-3 text-xs font-mono font-medium">
    <a href="#featured" class="block py-1 text-zinc-300 hover:text-white">Featured Project</a>
    <a href="#shipped" class="block py-1 text-zinc-300 hover:text-white">Shipped Releases</a>
    <a href="#prototypes" class="block py-1 text-zinc-300 hover:text-white">Prototypes &amp; R&amp;D</a>
    <a href="#skills" class="block py-1 text-zinc-300 hover:text-white">Technical Skills</a>
    <a href="#contact" class="block py-1 text-zinc-300 hover:text-white">Contact</a>
    <div class="pt-3 border-t border-[#27272a] flex items-center gap-2">
      <a
        href={developerProfile.itch}
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded border border-[#27272a] bg-zinc-900 text-zinc-300 text-xs hover:text-white"
      >
        itch.io
      </a>
      <a
        href="#contact"
        class="px-3 py-1.5 rounded bg-zinc-100 text-zinc-950 font-medium text-xs hover:bg-white"
      >
        Get in Touch
      </a>
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const hamburgerIcon = document.getElementById('navHamburgerIcon');
  const closeIcon = document.getElementById('navCloseIcon');

  if (mobileMenuBtn && mobileMenu && hamburgerIcon && closeIcon) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
