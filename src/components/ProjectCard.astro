---
export interface Feature {
  number: string;
  title: string;
  description: string;
}

export interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  url: string;
  thumbnail: string;
  fallbackThumbnail?: string;
  tags: string[];
  description: string;
  highlights?: string[];
  features?: Feature[];
  buttonText?: string;
}

const {
  title,
  subtitle,
  badge = "itch.io Release",
  url,
  thumbnail,
  fallbackThumbnail,
  tags,
  description,
  highlights = [],
  features = [],
  buttonText = "Play on itch.io"
} = Astro.props;
---

<article class="rounded-xl border border-[#27272a] bg-[#121316] overflow-hidden flex flex-col justify-between hover:border-zinc-600 transition-colors group">
  <!-- Aspect-Video Image Wrapper -->
  <div class="relative w-full aspect-video bg-[#09090b] border-b border-[#27272a] overflow-hidden flex items-center justify-center">
    <img
      src={thumbnail}
      alt={`${title} project thumbnail`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      onerror={fallbackThumbnail ? `this.onerror=null; this.src='${fallbackThumbnail}';` : undefined}
      loading="lazy"
    />

    <!-- Direct Overlay Hover Trigger -->
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="absolute inset-0 w-full h-full flex items-center justify-center bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-[2px]"
      aria-label={`Open ${title} on itch.io`}
    >
      <span class="px-3.5 py-1.5 rounded-lg bg-zinc-900/90 border border-zinc-700 text-xs font-mono font-medium text-white shadow-xl flex items-center gap-1.5">
        <span>{buttonText}</span>
        <span>&rarr;</span>
      </span>
    </a>

    <!-- Top Badge -->
    {badge && (
      <div class="absolute top-3 left-3 pointer-events-none">
        <span class="px-2.5 py-1 text-[10px] font-mono rounded bg-zinc-950/85 border border-[#27272a] text-zinc-300 backdrop-blur-sm">
          {badge}
        </span>
      </div>
    )}
  </div>

  <!-- Card Body -->
  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div class="space-y-3">
      <div>
        <h3 class="text-lg font-bold text-zinc-100 group-hover:text-emerald-400 transition-colors">
          {title}
        </h3>
        {subtitle && (
          <p class="text-xs font-mono text-zinc-500 mt-0.5">{subtitle}</p>
        )}
      </div>

      <!-- Tag Badges -->
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="px-2 py-0.5 text-[11px] font-mono rounded bg-zinc-900 border border-[#27272a] text-zinc-400">
            {tag}
          </span>
        ))}
      </div>

      <!-- Technical Description -->
      <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed font-normal">
        {description}
      </p>

      <!-- Optional Technical Highlights -->
      {highlights.length > 0 && (
        <ul class="pt-1 space-y-1.5 text-xs text-zinc-400">
          {highlights.map((item) => (
            <li class="flex items-start gap-2">
              <span class="mt-1.5 w-1 h-1 rounded-full bg-emerald-500 flex-shrink-0"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )}

      <!-- Optional Prototype Sub-Features -->
      {features.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-2">
          {features.map((feat) => (
            <div class="p-3 rounded-lg bg-[#09090b] border border-[#27272a] space-y-1">
              <span class="text-[11px] font-mono font-semibold text-zinc-300 block">
                {feat.number} // {feat.title}
              </span>
              <p class="text-[11px] text-zinc-400 leading-relaxed">
                {feat.description}
              </p>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Direct itch.io Link Button -->
    <div class="pt-4 border-t border-[#27272a]">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border border-[#27272a] bg-zinc-900/80 text-xs font-mono font-medium text-zinc-200 hover:text-white hover:border-zinc-500 hover:bg-zinc-800 transition-all group/btn"
      >
        <svg class="w-3.5 h-3.5 fill-current text-[#fa5c5c]" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M2.5 4.5v1.2l2.3 2.3-2.3 2.3v9.2l4.6 2.3 4.6-2.3-2.3-2.3 2.3-2.3h4.6l2.3 2.3-2.3 2.3 4.6 2.3 4.6-2.3v-9.2l-2.3-2.3 2.3-2.3V4.5l-4.6 2.3-4.6-2.3-2.3 2.3-2.3-2.3-4.6 2.3-4.6-2.3zm6.9 7.4a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zm5.2 0a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6z"/>
        </svg>
        <span>{buttonText}</span>
        <svg class="w-3 h-3 text-zinc-500 group-hover/btn:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>
  </div>
</article>
