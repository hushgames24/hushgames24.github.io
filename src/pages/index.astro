---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillsSection from '../components/SkillsSection.astro';
import Footer from '../components/Footer.astro';
import GameplayModal from '../components/GameplayModal.astro';
import CopyToast from '../components/CopyToast.astro';

import {
  developerProfile,
  shippedProjects,
  prototypeProjects,
} from '../data/portfolioData';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{developerProfile.name} — {developerProfile.title}</title>
    <meta
      name="description"
      content="Portfolio of Harvey Jay Pilapil — Unity & Gameplay Programmer specializing in decoupled gameplay systems, AI state machines, and performant C# architecture."
    />
    <meta
      name="keywords"
      content="Harvey Jay Pilapil, Unity Programmer, Gameplay Programmer, C#, ScriptableObjects, Game Architecture, Banana Farm Chaos, Sister Claire's Orphanage"
    />
    <meta property="og:title" content={`${developerProfile.name} — ${developerProfile.title}`} />
    <meta
      property="og:description"
      content="Decoupled gameplay architecture, finite state machines, and performant C# systems in Unity."
    />
    <meta property="og:type" content="website" />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#09090b] text-zinc-300 font-sans antialiased selection:bg-zinc-800 selection:text-zinc-100 min-h-screen flex flex-col">
    <!-- Navigation Bar -->
    <Navbar />

    <!-- Main Content Container -->
    <main id="top" class="flex-1 max-w-5xl mx-auto w-full px-5 sm:px-8 py-16 sm:py-24 space-y-24 sm:space-y-32">
      <!-- 1. Hero / Intro Section -->
      <Hero />

      <!-- 2. Featured Production (Banana Farm Chaos) -->
      <FeaturedProject />

      <!-- 3. Shipped Releases (itch.io) -->
      <section id="shipped" class="space-y-6 pt-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-4 border-b border-[#27272a]">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-zinc-500 font-medium">Published Games</span>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100 mt-0.5">Shipped Releases</h2>
          </div>
          <a
            href={developerProfile.itch}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-400 hover:text-white transition-colors"
          >
            <span>hushgames24.itch.io</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {shippedProjects.map((project) => (
            <ProjectCard
              title={project.title}
              subtitle={project.subtitle}
              badge={project.badge}
              url={project.url}
              thumbnail={project.thumbnail}
              fallbackThumbnail={project.fallbackThumbnail}
              tags={project.tags}
              description={project.description}
              highlights={project.highlights}
            />
          ))}
        </div>
      </section>

      <!-- 4. Prototypes & R&D -->
      <section id="prototypes" class="space-y-6 pt-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-4 border-b border-[#27272a]">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-zinc-500 font-medium">R&amp;D &amp; Systems Exploration</span>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100 mt-0.5">Prototypes &amp; Systems</h2>
          </div>
          <span class="text-xs font-mono text-zinc-500">Physics, LoS &amp; Mechanics</span>
        </div>

        <div class="grid grid-cols-1 gap-6">
          {prototypeProjects.map((proto) => (
            <ProjectCard
              title={proto.title}
              subtitle={proto.category}
              badge={proto.badge}
              url={proto.url}
              thumbnail={proto.thumbnail}
              fallbackThumbnail={proto.fallbackThumbnail}
              tags={proto.tags}
              description={proto.description}
              features={proto.features}
              buttonText="Play Demo on itch.io"
            />
          ))}
        </div>
      </section>

      <!-- 5. Technical Skills Summary -->
      <SkillsSection />

      <!-- 6. Contact & Collaboration -->
      <section id="contact" class="pt-6">
        <div class="rounded-xl border border-[#27272a] bg-[#121316] p-8 sm:p-12 text-center space-y-6">
          <div class="max-w-xl mx-auto space-y-3">
            <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-semibold">Get in Touch</span>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100">
              Let's Build Great Games
            </h2>
            <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed font-normal">
              I am open for gameplay programming roles, contract collaborations, and technical engineering inquiries.
            </p>
          </div>

          <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <!-- Direct Email Link -->
            <a
              href={`mailto:${developerProfile.email}`}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-zinc-100 text-zinc-950 text-xs font-mono font-semibold hover:bg-white transition-all shadow-sm"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span>{developerProfile.email}</span>
            </a>

            <!-- Copy Email Button -->
            <button
              id="contactCopyEmailBtn"
              type="button"
              data-email={developerProfile.email}
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-[#27272a] bg-zinc-900 text-zinc-300 text-xs font-mono font-medium hover:border-zinc-500 hover:text-white transition-all"
            >
              <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              <span>Copy Address</span>
            </button>

            <!-- itch.io Direct -->
            <a
              href={developerProfile.itch}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-[#27272a] bg-zinc-900 text-zinc-200 text-xs font-mono font-medium hover:border-zinc-500 hover:text-white transition-all"
            >
              <svg class="w-3.5 h-3.5 fill-current text-[#fa5c5c]" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M2.5 4.5v1.2l2.3 2.3-2.3 2.3v9.2l4.6 2.3 4.6-2.3-2.3-2.3 2.3-2.3h4.6l2.3 2.3-2.3 2.3 4.6 2.3 4.6-2.3v-9.2l-2.3-2.3 2.3-2.3V4.5l-4.6 2.3-4.6-2.3-2.3 2.3-2.3-2.3-4.6 2.3-4.6-2.3zm6.9 7.4a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zm5.2 0a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6z"/>
              </svg>
              <span>itch.io Profile</span>
            </a>
          </div>

          <div class="pt-4 flex items-center justify-center gap-5 text-xs font-mono text-zinc-500">
            <a href={developerProfile.github} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-300 transition-colors">
              GitHub
            </a>
            <span>&bull;</span>
            <a href={developerProfile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-300 transition-colors">
              LinkedIn
            </a>
            <span>&bull;</span>
            <a href={developerProfile.itch} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-300 transition-colors">
              itch.io
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Gameplay Video Demonstration Modal -->
    <GameplayModal />

    <!-- 1-Click Clipboard Toast Notification -->
    <CopyToast />
  </body>
</html>
