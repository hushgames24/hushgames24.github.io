---
import { technicalSkills, summarySkillBadges } from '../data/portfolioData';
---

<section id="skills" class="space-y-6 pt-6">
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-4 border-b border-[#27272a]">
    <div>
      <span class="text-xs font-mono uppercase tracking-wider text-zinc-500 font-medium">Core Competencies</span>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100 mt-0.5">Technical Skills</h2>
    </div>
    <span class="text-xs font-mono text-zinc-500">Languages, Systems &amp; Tooling</span>
  </div>

  <!-- Categorized Clean Grid (No Rating Meters or Progress Bars) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {technicalSkills.map((category) => (
      <div class="p-5 rounded-xl border border-[#27272a] bg-[#121316] flex flex-col justify-between space-y-4 hover:border-zinc-700 transition-colors">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-mono uppercase text-emerald-400 font-semibold tracking-wider">
              {category.category}
            </h3>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500/60"></span>
          </div>

          <ul class="space-y-2 text-xs font-mono">
            {category.items.map((item, idx) => (
              <li class={`flex flex-col py-1.5 ${idx !== category.items.length - 1 ? 'border-b border-[#27272a]/60' : ''}`}>
                <span class="font-medium text-zinc-200">{item.name}</span>
                <span class="text-zinc-500 text-[11px] mt-0.5">{item.context}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>

  <!-- Summary Skill Cloud -->
  <div class="p-4 rounded-xl border border-[#27272a] bg-[#0e0f12] flex flex-wrap items-center gap-2 text-xs font-mono">
    <span class="text-zinc-500 font-medium mr-2">Key Stack:</span>
    {summarySkillBadges.map((badge) => (
      <span class="px-2.5 py-1 rounded-lg bg-zinc-900 border border-[#27272a] text-zinc-300 hover:border-emerald-500/40 hover:text-white transition-colors">
        {badge}
      </span>
    ))}
  </div>
</section>
