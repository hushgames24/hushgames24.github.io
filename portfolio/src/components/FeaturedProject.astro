---
import { flagshipProject } from '../data/portfolioData';
---

<section id="featured" class="space-y-6 pt-6">
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-4 border-b border-[#27272a]">
    <div>
      <span class="text-xs font-mono uppercase tracking-wider text-zinc-500 font-medium">Flagship Production</span>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-100 mt-0.5">{flagshipProject.title}</h2>
    </div>
    <div class="flex items-center gap-2 text-xs font-mono text-zinc-400">
      <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
      <span>{flagshipProject.status}</span>
    </div>
  </div>

  <!-- Featured Project Card Container -->
  <div class="rounded-xl border border-[#27272a] bg-[#121316] overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12">

      <!-- Media Container (7 cols) -->
      <div class="lg:col-span-7 bg-[#09090b] border-b lg:border-b-0 lg:border-r border-[#27272a] relative flex flex-col justify-between group">
        
        <!-- Viewport Container -->
        <div class="relative w-full aspect-video sm:aspect-[16/10] bg-[#09090b] overflow-hidden flex items-center justify-center">
          <img
            src={flagshipProject.thumbnail}
            alt={`${flagshipProject.title} gameplay media`}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            onerror={`this.onerror=null; this.src='${flagshipProject.fallbackThumbnail}';`}
            loading="eager"
          />

          <!-- Play / Demo Trigger Button -->
          <button
            id="openDemoModalBtn"
            type="button"
            aria-label="Open gameplay demo player"
            class="absolute inset-0 m-auto w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-zinc-950/80 border border-zinc-700 text-white flex items-center justify-center backdrop-blur-md shadow-2xl transition-all duration-300 group-hover:scale-110 group-hover:border-emerald-500/80 group-hover:bg-zinc-900 focus:outline-none focus:ring-2 focus:ring-emerald-400"
          >
            <svg class="w-6 h-6 translate-x-0.5 fill-current text-zinc-100" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>

          <!-- Top-Left Tag -->
          <div class="absolute top-3 left-3 pointer-events-none">
            <span class="px-2.5 py-1 text-[11px] font-mono rounded bg-zinc-950/90 border border-[#27272a] text-zinc-200 backdrop-blur-sm">
              Solo Gameplay Engineering
            </span>
          </div>

          <!-- Bottom-Right Tag -->
          <div class="absolute bottom-3 right-3 pointer-events-none">
            <span class="px-2.5 py-1 text-[10px] font-mono rounded bg-zinc-950/90 border border-[#27272a] text-zinc-300 backdrop-blur-sm flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
              <span>Watch Gameplay Demo</span>
            </span>
          </div>
        </div>

        <!-- Media Bar Sub-footer -->
        <div class="px-4 py-3 border-t border-[#27272a] bg-[#0e0f12] flex items-center justify-between text-xs font-mono text-zinc-400">
          <span class="truncate mr-2">{flagshipProject.subtitle}</span>
          <button
            id="toggleCodeSnippetBtn"
            type="button"
            class="text-zinc-300 hover:text-emerald-400 underline underline-offset-4 transition-colors flex-shrink-0 flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
            <span id="toggleCodeSnippetText">View Architecture Sample</span>
          </button>
        </div>
      </div>

      <!-- Project Details & Engineering Breakdown (5 cols) -->
      <div class="lg:col-span-5 p-6 sm:p-7 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div>
            <span class="text-xs font-mono text-emerald-400/90 font-medium">Role: {flagshipProject.role}</span>
            <h3 class="text-xl font-bold text-zinc-100 mt-1">Core Architecture &amp; Loops</h3>
          </div>

          <!-- Tech Stack Badges -->
          <div class="flex flex-wrap gap-1.5 pt-1">
            {flagshipProject.tags.map((tag) => (
              <span class="px-2 py-0.5 text-xs font-mono rounded bg-zinc-900 border border-[#27272a] text-zinc-300">
                {tag}
              </span>
            ))}
          </div>

          <!-- Key Technical Highlights -->
          <ul class="space-y-3 pt-2 text-xs sm:text-sm text-zinc-400 leading-relaxed">
            {flagshipProject.highlights.map((highlight) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
                <span>
                  <strong class="text-zinc-200 font-medium">{highlight.title}:</strong>{" "}
                  {highlight.description}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Action CTAs -->
        <div class="pt-4 border-t border-[#27272a] flex flex-wrap items-center gap-2.5">
          <button
            id="featuredWatchDemoBtn"
            type="button"
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-zinc-100 text-zinc-950 text-xs font-mono font-semibold hover:bg-white transition-all shadow-sm"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
            <span>Watch Gameplay Demo</span>
          </button>

          {flagshipProject.repoUrl && (
            <a
              href={flagshipProject.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-[#27272a] bg-zinc-900 text-zinc-300 text-xs font-mono font-medium hover:border-zinc-500 hover:text-white transition-all"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
              <span>GitHub</span>
            </a>
          )}
        </div>

      </div>
    </div>

    <!-- Expandable C# Architecture Snippet Drawer -->
    <div id="codeSnippetDrawer" class="hidden border-t border-[#27272a] bg-[#0e0f12] p-5 sm:p-6 transition-all duration-300">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 mb-3 border-b border-[#27272a] text-xs font-mono text-zinc-400">
        <span class="text-zinc-300 font-medium">{flagshipProject.codeSnippet.filename}</span>
        <span class="text-emerald-400">{flagshipProject.codeSnippet.pattern}</span>
      </div>
      <pre class="text-xs font-mono text-zinc-300 overflow-x-auto leading-relaxed p-4 bg-[#09090b] rounded-lg border border-[#27272a]"><code>{flagshipProject.codeSnippet.code}</code></pre>
    </div>
  </div>
</section>

<script>
  const toggleCodeBtn = document.getElementById('toggleCodeSnippetBtn');
  const codeDrawer = document.getElementById('codeSnippetDrawer');
  const toggleText = document.getElementById('toggleCodeSnippetText');

  if (toggleCodeBtn && codeDrawer && toggleText) {
    toggleCodeBtn.addEventListener('click', () => {
      codeDrawer.classList.toggle('hidden');
      const isHidden = codeDrawer.classList.contains('hidden');
      toggleText.textContent = isHidden ? 'View Architecture Sample' : 'Hide Architecture Sample';
    });
  }
</script>
